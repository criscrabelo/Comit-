# ─────────────────────────────────────────────────────────────────────────────
# Patrono Alta Performance — variaveis de ambiente
#
# REGRA OBRIGATORIA: nenhuma credencial real entra neste arquivo, no codigo-fonte
# ou no navegador. Este arquivo e apenas o modelo, versionado. O arquivo .env com
# valores reais NAO e versionado (ver .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3131
LOG_LEVEL=info

# Origens permitidas para CORS, separadas por virgula.
# Nunca use "*" — o codigo recusa "*" fora de development.
CORS_ORIGINS=http://localhost:3131

# ── Banco de dados ──────────────────────────────────────────────────────────
# PostgreSQL 16+. Em producao, exija sslmode=require.
DATABASE_URL=postgres://postgres@localhost:5432/patrono
DATABASE_POOL_MAX=10

# ── Sessoes ─────────────────────────────────────────────────────────────────
# Duracao da sessao em horas. Tokens sao opacos e revogaveis (tabela sessoes),
# por isso nao existe segredo de assinatura a rotacionar.
SESSAO_DURACAO_HORAS=12
SESSAO_INATIVIDADE_MINUTOS=60

# ── Integracao Monday.com ───────────────────────────────────────────────────
# Token pessoal do Monday. Fica SOMENTE aqui, no servidor.
# O navegador nunca recebe este valor. Ausente = integracao desligada.
MONDAY_TOKEN=
MONDAY_API_VERSION=2024-10

# ── Integracao Sienge ───────────────────────────────────────────────────────
# Conector em modo SOMENTE LEITURA e desligado por padrao.
# So liga depois que a rotina de verificacao de ambiente passar.
SIENGE_SUBDOMAIN=
SIENGE_USER=
SIENGE_PASSWORD=
# Mantenha em false ate confirmar endpoints e parametros no ambiente real da Coevo.
SIENGE_HABILITADO=false
SIENGE_REQUISICOES_POR_MINUTO=60

# ── Backup e restauracao ────────────────────────────────────────────────────
# Diretorio FORA do repositorio. Backup dentro do repositorio acaba num
# `git add -A` e vaza a base inteira para o controle de versao.
BACKUP_DIRETORIO=/var/backups/patrono

# Segundo destino, em outro volume ou montagem de rede. Sem ele, um unico disco
# guarda todos os backups — e o relatorio de continuidade alerta.
BACKUP_DIRETORIO_REDUNDANTE=

# Chave de cifra em repouso, minimo de 16 caracteres. OBRIGATORIA: sem ela
# nenhum backup e gerado, porque o dump contem CPF, contrato e situacao
# juridica de clientes reais.
#
# ATENCAO: perder esta chave torna TODOS os backups irrecuperaveis. Guarde-a no
# cofre de credenciais, FORA do servidor que hospeda os backups.
BACKUP_CHAVE=

# Hora do backup diario (0-23), no fuso do servidor. Vazio desliga o agendador
# embutido — use quando houver cron ou systemd timer externo.
BACKUP_HORA_DIARIA=3

# Trava adicional para restaurar sobre o banco em uso. Mesmo com perfil
# Administrador e permissao sistema:restaurar, sem esta variavel a restauracao
# em producao e recusada. Ligue apenas durante a janela de manutencao.
PERMITIR_RESTAURACAO_PRODUCAO=false

# Caminho de pg_dump/pg_restore/psql, quando nao estiverem no PATH.
PG_BIN=
